    "@openzeppelin/contracts": "^5.1",
    "@types/chai": "^4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.7.5",
    "chai": "^4",
    "ethers": "^6",
    "hardhat": "^2.26",
    "solc": "0.8.28",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
