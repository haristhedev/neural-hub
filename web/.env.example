# ── Public ─────────────────────────────────────────────────────────────
# Comma-separated chain ids shown in the network switcher (31337 local, 84532 Base Sepolia, 11155111 Sepolia, 80002 Polygon Amoy, 8453 Base, 137 Polygon, 1 Ethereum)
NEXT_PUBLIC_ENABLED_CHAINS=31337,84532,11155111,80002
NEXT_PUBLIC_DEFAULT_CHAIN=31337
# Get a free project id at https://cloud.reown.com — enables the WalletConnect (QR / mobile) option
NEXT_PUBLIC_WC_PROJECT_ID=
# Optional per-chain RPC overrides: NEXT_PUBLIC_RPC_<chainId>
NEXT_PUBLIC_RPC_31337=http://127.0.0.1:8545
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# ── Server only ────────────────────────────────────────────────────────
# JWT signing secret for wallet-login sessions (required in production)
SESSION_SECRET=change-me-to-a-long-random-string
# API gateway signer: holds GATEWAY_ROLE and records metered usage on-chain.
# Local default is Hardhat account #1 (publicly known test key — never use on a real network).
GATEWAY_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Optional: pin model metadata to IPFS via Pinata; without it metadata is stored as a data: URI
PINATA_JWT=
